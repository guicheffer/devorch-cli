ls -1 "spec-machine/context-training/\${CT_NAME}/implementers/"

# List verifier files
echo "Verifier files:"
ls -1 "spec-machine/context-training/\${CT_NAME}/verifiers/"

# Count total files
total_files=$(find "spec-machine/context-training/\${CT_NAME}" -type f | wc -l)
echo "Total files generated: \${total_files}"
