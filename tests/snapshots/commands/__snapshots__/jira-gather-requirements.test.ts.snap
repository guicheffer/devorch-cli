exports[`command snapshot: /jira-gather-requirements should match snapshot 1`] = `
"---
name: "/jira-gather-requirements"
description: "Fetch Jira ticket(s), gather requirements, and post clarifying questions to the ticket"
mode: "multi-agent"
dependencies:
